within ModeloDrone.SubSistemas;

model ControladorRotores
  invAllocationMatrix invAllocMat annotation(
    Placement(transformation(origin = {-30, 10}, extent = {{-10, -10}, {10, 10}})));
  Modelica.Mechanics.Rotational.Components.Inertia inertia annotation(
    Placement(transformation(origin = {52, 38}, extent = {{-10, -10}, {10, 10}})));
equation

end ControladorRotores;